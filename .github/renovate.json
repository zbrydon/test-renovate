{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "configMigration": true,
  "customManagers": [
    {
      "description": "ECR pull-through cache: prepend the ECR prefix to registry-qualified images (public.ecr.aws / registry.k8s.io / quay.io and docker.io/<namespace>/<image>), keeping the upstream path. Versions are looked up upstream.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile[^/]*$/"],
      "matchStrings": [
        "FROM\\s+(?<depName>(?:public\\.ecr\\.aws|registry\\.k8s\\.io|quay\\.io)/[^\\s:@]+):(?<currentValue>[^\\s]+)",
        "FROM\\s+(?<depName>docker\\.io/[^\\s:@]+/[^\\s:@]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "FROM 111111111111.dkr.ecr.ap-southeast-2.amazonaws.com/{{{depName}}}:{{{newValue}}}"
    },
    {
      "description": "ECR pull-through cache: prepend the ECR prefix to Docker Hub official images, injecting docker.io/library/. Matches explicitly-qualified official images (docker.io/<image>) and bare official images (<image>).",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile[^/]*$/"],
      "matchStrings": [
        "FROM\\s+docker\\.io/(?<depName>[^\\s/:@]+):(?<currentValue>[^\\s]+)",
        "FROM\\s+(?<depName>[^\\s/:@.${}]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "docker.io/library/{{{depName}}}",
      "autoReplaceStringTemplate": "FROM 111111111111.dkr.ecr.ap-southeast-2.amazonaws.com/docker.io/library/{{{depName}}}:{{{newValue}}}"
    },
    {
      "description": "ECR pull-through cache: prepend the ECR prefix to bare Docker Hub namespaced images (<namespace>/<image>), injecting docker.io/.",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile[^/]*$/"],
      "matchStrings": [
        "FROM\\s+(?<depName>[^\\s/:@.${}]+/[^\\s:@]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "docker.io/{{{depName}}}",
      "autoReplaceStringTemplate": "FROM 111111111111.dkr.ecr.ap-southeast-2.amazonaws.com/docker.io/{{{depName}}}:{{{newValue}}}"
    }
  ],
  "postUpdateOptions": ["pnpmDedupe"],
  "prCreation": "immediate",
  "prHourlyLimit": 10,
  "semanticCommitScope": "",
  "semanticCommitType": "deps"
}
